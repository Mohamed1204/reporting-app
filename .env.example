# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.
# Generate values with: openssl rand -base64 64

# Signs login tokens. At least 32 bytes.
JWT_SECRET=

# SQL Server sa password: 8+ chars with upper, lower and digits.
# Avoid ; $ and quotes - it is also embedded in the connection string.
MSSQL_SA_PASSWORD=
